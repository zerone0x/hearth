{
  "name": "hearth",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run pins && bun test",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "biome check --formatter-enabled=false .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "pins": "bun scripts/check-pins.ts",
    "test": "bun test",
    "dev:hub": "bun run --filter @hearth/hub dev",
    "build:web": "bun run --filter @hearth/web build",
    "e2e:web": "bun run --filter @hearth/web e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
