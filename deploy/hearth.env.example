# Copy to deploy/.env and edit (docs/install.md). Compose reads it on every
# `docker compose` command run in deploy/.

# The model the hub's pi runner uses (decision 0015). The key is not here: it
# goes in deploy/secrets/model_key. Leave HEARTH_MODEL empty to run without a
# model (sessions then refuse messages).
HEARTH_MODEL_PROVIDER=anthropic
HEARTH_MODEL=claude-sonnet-4-5

# A pi models.json for providers pi does not ship, such as an OpenAI-compatible
# endpoint. Put the file in deploy/config/ and name it by its path in the hub:
# HEARTH_MODELS_FILE=/etc/hearth/models.json
HEARTH_MODELS_FILE=

# The UI/API listener on the host. Keep it on loopback and publish it with a
# reverse proxy (TLS); set HEARTH_PUBLIC_ORIGIN to the proxy's origin.
HEARTH_HOST=127.0.0.1
HEARTH_PORT=8787
HEARTH_PUBLIC_ORIGIN=

# The port of the box listeners on each box network's gateway (decision 0012).
HEARTH_BOX_PORT=8788

# IPv4 CIDRs boxes may reach despite the firewall, e.g. a LAN DNS resolver.
HEARTH_BOX_EGRESS_ALLOW=

# Minutes before an idle session's box is stopped (default 15).
HEARTH_IDLE_MINUTES=

# The hub build stamped on trajectories, spans and /healthz (decision 0021).
# The configure and upgrade steps of docs/install.md set it to the checkout's
# `git describe --always --dirty`; empty means apps/hub/package.json's version.
HEARTH_VERSION=
